    },
    {
      "label": "Detalle de la información y documentos solicitados",
      "type": "textarea",
      "layout": {
        "row": "Row_0ogz767",
        "columns": null
      },
      "id": "Field_1rhvaju",
      "key": "informacionSolicitada",
      "description": "Especifique claramente qué debe presentar el ciudadano",
      "validate": {
        "required": true,
        "minLength": "20"
      }
    },
    {
      "label": "Fecha límite para presentar documentación",
      "type": "textfield",
      "layout": {
        "row": "Row_0ogz767",
        "columns": null
      },
      "id": "Field_07612y3",
      "key": "textfield_w8ozx",
      "description": "Formato: YYYY-MM-DD (máximo 30 días) ",
      "defaultValue": "fechaLimiteDocumentos",
      "validate": {
        "required": true
      }
    },
    {
      "label": "¿Confirmar envío de solicitud al ciudadano?",
      "values": [
        {
          "label": "Enviar",
          "value": "true"
        },
        {
          "label": "Cancelar",
          "value": "false"
        }
      ],
      "type": "radio",
      "layout": {
        "row": "Row_0ogz767",
        "columns": null
      },
      "id": "Field_0fmjhpx",
      "key": "solicitudEnviada"
