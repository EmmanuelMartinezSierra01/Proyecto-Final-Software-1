    },
    {
      "label": "¿El ciudadano presentó la documentación complementaria solicitada?",
      "values": [
        {
          "label": "Documentación presentada",
          "value": "true"
        },
        {
          "label": "No presentó documentación",
          "value": "false"
        }
      ],
