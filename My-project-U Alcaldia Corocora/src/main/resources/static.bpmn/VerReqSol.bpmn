        <camunda:inputOutput>
          <camunda:outputParameter name="estadoPQRS">false</camunda:outputParameter>
          <camunda:outputParameter name="motivoCierre">Debido a falta de respuesta por parte del solicitante a la peticion de rellenar los campos faltantes</camunda:outputParameter>
