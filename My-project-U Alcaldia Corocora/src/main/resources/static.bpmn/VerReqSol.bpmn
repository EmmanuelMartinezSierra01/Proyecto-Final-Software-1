    </bpmn:endEvent>
    <bpmn:startEvent id="Event_0kcwi71" name="Solicitud recibida" camunda:initiator="">
      <bpmn:outgoing>Flow_1fb0wws</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Activity_0b8vgrl" name="Enviar a dependencia competente">
