  <bpmn:process id="VerReqSol" isExecutable="true" camunda:historyTimeToLive="1">
    <bpmn:businessRuleTask id="Activity_1xd5yvi" name="Asignar a dependencia competente" camunda:resultVariable="dependenciaAsignada" camunda:decisionRef="asignarDependencia" camunda:mapDecisionResult="singleEntry" camunda:decisionRefTenantId="">
      <bpmn:incoming>Flow_1rkxok6</bpmn:incoming>
      <bpmn:outgoing>Flow_0ld8r2z</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="Activity_0ri5tlv" name="Verificar documentos requeridos" camunda:resultVariable="documentosCompletos" camunda:decisionRef="verificarDocumentos" camunda:mapDecisionResult="singleEntry">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_1ygfczg</bpmn:incoming>
      <bpmn:outgoing>Flow_181e1u7</bpmn:outgoing>
