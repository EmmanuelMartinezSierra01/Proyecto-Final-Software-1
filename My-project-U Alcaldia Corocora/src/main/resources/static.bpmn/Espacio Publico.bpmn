    <bpmn:startEvent id="StartEvent_1" name="Solicitud de uso de espacio" camunda:formRef="solicitudEspacio" camunda:formRefBinding="latest">
      <bpmn:extensionElements />
      <bpmn:outgoing>Flow_1n0xut4</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_1mspgog" name="Revisar documentación entregada" camunda:formRef="RevD" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_1n0xut4</bpmn:incoming>
      <bpmn:outgoing>Flow_1c74moz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0jmicbn" name="¿Paso la revisión de documentación?">
      <bpmn:incoming>Flow_1c74moz</bpmn:incoming>
      <bpmn:outgoing>Flow_0xjzcxh</bpmn:outgoing>
      <bpmn:outgoing>Flow_0t8yyyi</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Event_1t6fwlh" name="Solicitud cancelada">
      <bpmn:incoming>Flow_0t8yyyi</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_1ihplv9" name="Evaluar espacio solicitado" camunda:formRef="RevEsp" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_0xjzcxh</bpmn:incoming>
      <bpmn:outgoing>Flow_07nk7qt</bpmn:outgoing>
