      <bpmn:incoming>Flow_1tpxbid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_124zsbn" name="¿Paso la evaluación del espacio?" default="Flow_1tpxbid">
      <bpmn:incoming>Flow_07nk7qt</bpmn:incoming>
      <bpmn:outgoing>Flow_1tpxbid</bpmn:outgoing>
      <bpmn:outgoing>Flow_0h6nxk4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
