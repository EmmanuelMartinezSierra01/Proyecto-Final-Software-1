      <bpmn:incoming>Flow_0uqd3j1</bpmn:incoming>
      <bpmn:outgoing>Flow_0fh70m1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_1n0xut4" sourceRef="StartEvent_1" targetRef="Activity_1mspgog" />
    <bpmn:sequenceFlow id="Flow_1c74moz" sourceRef="Activity_1mspgog" targetRef="Gateway_0jmicbn" />
    <bpmn:sequenceFlow id="Flow_0xjzcxh" name="Si" sourceRef="Gateway_0jmicbn" targetRef="Activity_1ihplv9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${Solicitud == true &amp;&amp; Documentos == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0t8yyyi" name="No" sourceRef="Gateway_0jmicbn" targetRef="Event_1t6fwlh">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!Solicitud || !Documentos}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07nk7qt" sourceRef="Activity_1ihplv9" targetRef="Gateway_124zsbn" />
    <bpmn:sequenceFlow id="Flow_1tpxbid" name="No" sourceRef="Gateway_124zsbn" targetRef="Event_0b5wcf3" />
    <bpmn:sequenceFlow id="Flow_0h6nxk4" name="Si" sourceRef="Gateway_124zsbn" targetRef="Activity_122rtf6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${RevEsp.contains("EspacioLibre") &amp;&amp; RevEsp.contains("UsoCorrecto")}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_163lr15" sourceRef="Activity_122rtf6" targetRef="Gateway_1cdbgz1" />
    <bpmn:sequenceFlow id="Flow_1cjwxpy" name="No" sourceRef="Gateway_11ua2qg" targetRef="Gateway_1cdbgz1" />
    <bpmn:sequenceFlow id="Flow_0uqd3j1" sourceRef="Gateway_1cdbgz1" targetRef="Activity_19i35t2" />
    <bpmn:sequenceFlow id="Flow_0fh70m1" sourceRef="Activity_19i35t2" targetRef="Gateway_11ua2qg" />
    <bpmn:sequenceFlow id="Flow_1rwoava" name="Si" sourceRef="Gateway_11ua2qg" targetRef="Event_03wuzk4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${RecibirPago &gt;= variableTotal}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
