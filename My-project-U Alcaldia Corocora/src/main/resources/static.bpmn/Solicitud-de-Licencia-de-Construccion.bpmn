    <bpmn:sequenceFlow id="Flow_0cbu9qm" sourceRef="emitirConcepto" targetRef="Gateway_0rupzw7" />
    <bpmn:sequenceFlow id="Flow_0j2ehkb" name="Si" sourceRef="Gateway_0rupzw7" targetRef="generarLicencia">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#{conceptoFavorable == true}</bpmn:conditionExpression>
