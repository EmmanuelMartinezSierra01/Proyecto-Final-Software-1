    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="revisarDocumentacion" name="Revisar documentación completa" calledElement="RevDocCom" camunda:calledElementTenantId="">
      <bpmn:extensionElements>
        <camunda:out source="documentacionCompleta" target="documentacionCompleta" />
        <camunda:in source="solicitudId" target="solicitudId" />
        <camunda:in source="nombreSolicitante" target="nombreSolicitante" />
        <camunda:in source="direccionObra" target="direccionObra" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0oh23rd</bpmn:incoming>
      <bpmn:outgoing>Flow_1f8xwad</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="evaluacionJuridica" name="Realizar evaluación jurídica" camunda:formRef="evaluacionjuridica" camunda:formRefBinding="latest" camunda:candidateGroups="unidad-juridica">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="solicitudId">${solicitudId}</camunda:inputParameter>
          <camunda:inputParameter name="nombreSolicitante">${nombreSolicitante}</camunda:inputParameter>
          <camunda:inputParameter name="direccionObra">${direccionObra}</camunda:inputParameter>
          <camunda:inputParameter name="documentoIdentidad">${documentoIdentidad}</camunda:inputParameter>
          <camunda:outputParameter name="evaluacionJuridica">${evaluacionJuridica}</camunda:outputParameter>
          <camunda:outputParameter name="observacionesJuridicas">${observacionesJuridicas}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0akbzm6</bpmn:incoming>
      <bpmn:outgoing>Flow_0filcx4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="evaluacionTecnica" name="Realizar evaluación técnica" camunda:formRef="evaluaciontecnica" camunda:formRefBinding="latest" camunda:candidateGroups="unidad-tecnica">
