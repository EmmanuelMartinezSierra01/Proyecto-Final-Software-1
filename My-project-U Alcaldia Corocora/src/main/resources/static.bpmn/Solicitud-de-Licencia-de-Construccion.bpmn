    <bpmn:sequenceFlow id="Flow_1jwpgub" name="No" sourceRef="Gateway_0rupzw7" targetRef="Activity_11ocqi3">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#{conceptoFavorable == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1vy0g8a" sourceRef="recepcionSolicitud" targetRef="registrarSolicitud" />
