          <camunda:inputParameter name="observacionesTecnicas">${observacionesTecnicas}</camunda:inputParameter>
          <camunda:inputParameter name="observacionesJuridicas">${observacionesJuridicas}</camunda:inputParameter>
          <camunda:outputParameter name="conceptoFavorable">${conceptoFavorable == "true"}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0filcx4</bpmn:incoming>
      <bpmn:outgoing>Flow_0cbu9qm</bpmn:outgoing>
