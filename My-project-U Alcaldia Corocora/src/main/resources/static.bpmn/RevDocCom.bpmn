    <bpmn:userTask id="Activity_14b99wt" name="Revisar documentación" camunda:formRef="revisardocumentacion" camunda:formRefBinding="latest">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="solicitudId">${solicitudId}</camunda:inputParameter>
